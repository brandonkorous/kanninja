{
    "name": "@kanninja/backend",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsup",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "create-api-key": "tsx src/scripts/create-api-key.ts",
        "reconcile-seats": "tsx src/scripts/reconcile-seats.ts"
    },
    "dependencies": {
        "@clerk/fastify": "^2.0.0",
        "@fastify/cors": "^10.0.0",
        "@fastify/rate-limit": "^10.0.0",
        "@fastify/websocket": "^11.0.0",
        "@kanninja/shared": "workspace:*",
        "@supabase/supabase-js": "^2.49.0",
        "dotenv": "^16.4.0",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.2.0",
        "fastify-plugin": "^5.1.0",
        "llm-harness": "0.2.0",
        "openai": "^6.34.0",
        "postgres": "^3.4.0",
        "stripe": "^17.0.0",
        "svix": "^1.45.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "drizzle-kit": "^0.31.10",
        "tsup": "^8.5.1",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}