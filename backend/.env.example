# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenAI
OPENAI_API_KEY=sk-xxx

# Integrations — token encryption
INTEGRATION_ENCRYPTION_KEY=   # 32 random bytes, hex-encoded (64 chars): openssl rand -hex 32

# Google (Calendar, Gmail, Drive, Docs — single OAuth app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Microsoft (Teams, Outlook, OneDrive — single Azure AD app)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=             # "common" for multi-tenant, or specific tenant ID

# Atlassian (Jira, Bitbucket, Confluence — single OAuth app)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# GitLab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_INSTANCE_URL=             # Leave empty for gitlab.com, or set for self-hosted

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Figma
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Loom
LOOM_CLIENT_ID=
LOOM_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Intercom
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
