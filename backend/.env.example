# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database — Azure Database for PostgreSQL Flexible Server.
# TLS is mandatory (require_secure_transport = ON); src/db/index.ts enables it
# automatically for any non-localhost host.
DATABASE_URL=postgresql://kanninja_admin:password@kanninja-prod-pg.postgres.database.azure.com:5432/kanninja
# Per-process pool size. Total = this x replicas, plus the CronJob.
DB_POOL_MAX=10

# Azure Blob Storage — card attachments
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=card-attachments

# Better Auth
# openssl rand -base64 32 — rotating this signs every user out.
BETTER_AUTH_SECRET=
# Public origin of THIS api, where /api/auth/* is served from.
BETTER_AUTH_URL=http://localhost:3001
# Parent domain so kanninja.com can send the cookie to api.kanninja.com.
# Leave EMPTY in local dev — localhost rejects a dot-prefixed cookie domain.
AUTH_COOKIE_DOMAIN=

# Google sign-in. Separate OAuth client from GOOGLE_CLIENT_ID below (which is
# the Calendar/Gmail/Drive data integration) — different consent scopes.
# Redirect URI: /api/auth/callback/google
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Transactional email (verification codes, password resets).
# Unset in dev: messages are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=kanNINJA <noreply@kanninja.com>

# Clerk — OUTGOING. Keeps the legacy verification branch in require-auth.ts
# alive during the Better Auth rollback window; clearing CLERK_SECRET_KEY
# disables it. Delete this block at T+7d after cutover.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenAI
# Azure OpenAI — Whisper transcription only (voice capture).
# kanNINJA runs no reasoning models; agents bring their own over MCP.
AZURE_OPENAI_ENDPOINT=https://oai-jotdojo-prod-eus2.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_SPEECH_DEPLOYMENT=jotdojo-speech

# Integrations — token encryption
INTEGRATION_ENCRYPTION_KEY=   # 32 random bytes, hex-encoded (64 chars): openssl rand -hex 32

# Google (Calendar, Gmail, Drive, Docs — single OAuth app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Microsoft (Teams, Outlook, OneDrive — single Azure AD app)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=             # "common" for multi-tenant, or specific tenant ID

# Atlassian (Jira, Bitbucket, Confluence — single OAuth app)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# GitLab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_INSTANCE_URL=             # Leave empty for gitlab.com, or set for self-hosted

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Figma
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Loom
LOOM_CLIENT_ID=
LOOM_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Intercom
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
