# syntax=docker/dockerfile:1.7
# MCP server — runs as a stdio subprocess for agent clients.
# This image is published so users can run the MCP server in a container
# (e.g. `docker run -e KANNINJA_API_KEY=... ghcr.io/wizeworks/kanninja-mcp`).
# It is NOT deployed to the AKS cluster.

# ---------- build (deps + compile) ----------
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY mcp-server/package.json ./mcp-server/

# Install deps for mcp AND its workspace deps (shared).
# Trailing `...` is load-bearing.
RUN pnpm install --frozen-lockfile --filter @kanninja/mcp...

COPY shared ./shared
COPY mcp-server ./mcp-server

RUN pnpm --filter @kanninja/shared run build \
 && pnpm --filter @kanninja/mcp run build

RUN pnpm --filter @kanninja/mcp deploy --prod /out

# ---------- runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    KANNINJA_API_URL=https://api.kanninja.com
COPY --from=build /out/dist ./dist
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
ENTRYPOINT ["node", "dist/index.js"]
