**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/.cache

# TypeScript incremental build cache — stale copies from the host trick
# tsc into thinking the build is up-to-date and emitting NOTHING, even
# when dist/ is missing. Keep this out of the image at all costs.
**/*.tsbuildinfo

# env
**/.env
**/.env.local
**/.env.*.local

# git / editor
.git
.gitignore
.github
.vscode
.idea
**/*.log

# docs / captures (not needed in image)
demo-video
docs
*.md
!backend/**/*.md
!frontend/**/*.md
!shared/**/*.md

# tooling
fly.*.toml
Dockerfile*
.dockerignore
