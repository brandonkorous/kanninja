{
  "name": "kanninja",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter !kanninja-mcp run dev",
    "dev:backend": "pnpm --filter @kanninja/backend run dev",
    "dev:frontend": "pnpm --filter @kanninja/frontend run dev",
    "dev:mcp": "pnpm --filter kanninja-mcp run dev",
    "build": "pnpm --filter @kanninja/shared run build && pnpm -r --parallel run build --filter !@kanninja/shared",
    "build:shared": "pnpm --filter @kanninja/shared run build",
    "build:deps": "pnpm --filter @kanninja/shared run build && pnpm --filter kanninja-mcp run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "hono": ">=4.13.11",
      "ws": ">=8.21.0",
      "@hono/node-server": "^1.19.15",
      "body-parser": ">=2.3.0",
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "source-map-js": ">=1.2.2",
      "ip-address": ">=10.7.4",
      "qs": ">=6.16.0",
      "proxy-addr": ">=2.0.8",
      "zod@4.4.3": "4.6.7"
    }
  }
}
