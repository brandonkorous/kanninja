# Backend API. Auth lives here too — the Better Auth client talks to
# ${NEXT_PUBLIC_API_URL}/api/auth/*, and the session cookie is scoped to the
# shared parent domain so kanninja.com can send it to api.kanninja.com.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Microsoft Clarity (session replay + heatmaps). Loaded only when the visitor
# has granted session-replay consent. Leave blank to disable. The Project ID
# is the alphanumeric string from clarity.microsoft.com → Settings → Setup.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Analytics 4 (page views + events). Loaded only when the visitor has
# granted analytics consent. Leave blank to disable. Measurement ID is in
# the G-XXXXXXXXXX format from analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
