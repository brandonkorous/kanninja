# syntax=docker/dockerfile:1.7

# ---------- build (deps + compile) ----------
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* must be present at build time — Next.js bakes them into the client bundle.
#
# Auth needs nothing here any more. Better Auth is server-side on the API, and
# the browser client is configured entirely from NEXT_PUBLIC_API_URL — there is
# no publishable key and no sign-in URL to bake in. Supabase is gone too:
# realtime is a WebSocket to our own API.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ARG NEXT_PUBLIC_CLARITY_PROJECT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID \
    NEXT_PUBLIC_CLARITY_PROJECT_ID=$NEXT_PUBLIC_CLARITY_PROJECT_ID

COPY . .

RUN pnpm install --frozen-lockfile

# Topologically build shared, then frontend (Next.js `next build`).
RUN pnpm -r --filter @kanninja/frontend... run build

# ---------- runtime ----------
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Uses Next.js standalone output — see frontend/next.config.ts
COPY --from=build /app/frontend/.next/standalone ./
COPY --from=build /app/frontend/.next/static ./frontend/.next/static
COPY --from=build /app/frontend/public ./frontend/public

EXPOSE 3000
CMD ["node", "frontend/server.js"]
