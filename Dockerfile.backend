# syntax=docker/dockerfile:1.7

# ---------- build (deps + compile) ----------
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Workspace manifests first (lets the install layer cache on lockfile changes only).
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/

# Install deps for backend AND its workspace deps.
# The trailing `...` is load-bearing — it pulls in @kanninja/shared.
RUN pnpm install --frozen-lockfile --filter @kanninja/backend...

# Now copy sources (cached separately from deps).
COPY shared ./shared
COPY backend ./backend

# Shared must compile before backend's tsc runs — backend imports from shared/dist.
RUN pnpm --filter @kanninja/shared run build \
 && pnpm --filter @kanninja/backend run build

# Assemble a pruned runtime tree (prod deps only, shared inlined).
RUN pnpm --filter @kanninja/backend deploy --prod /out

# ---------- runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0
COPY --from=build /out/dist ./dist
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
EXPOSE 3001
CMD ["node", "dist/index.js"]
