# syntax=docker/dockerfile:1.7

# ---------- build (deps + compile) ----------
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /app

# Copy the full workspace first so pnpm can set up symlinks against real
# directories. `.dockerignore` keeps node_modules / dist / .next out of the
# context, so this is just source + manifests.
COPY . .

# Install all workspace deps. A full install is more reliable for workspace
# symlink setup than `--filter`, and the extra install time is amortised by
# the GHA buildx cache layer.
RUN pnpm install --frozen-lockfile

# `-r --filter @kanninja/backend...` topologically builds shared first, then backend.
RUN pnpm -r --filter @kanninja/backend... run build

# Assemble a pruned runtime tree (prod deps only, shared inlined).
# `--legacy` is required on pnpm 10 when the source workspace doesn't set
# `inject-workspace-packages=true` (see ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE).
RUN pnpm --filter @kanninja/backend deploy --prod --legacy /out

# ---------- runtime ----------
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0
COPY --from=build /out/dist ./dist
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json

# The SQL migrations, which are DATA rather than code and so are not emitted by
# tsup into dist/.
#
# WITHOUT THIS THERE IS NO WAY TO MIGRATE PRODUCTION AT ALL. Azure Postgres is
# private-endpoint only, so `pnpm db:migrate` from a laptop or a CI runner
# cannot reach it — the migration has to run as a Job using this image, and
# src/db/migrate.ts reads `migrationsFolder: './drizzle'` relative to the
# working directory. docs/deployment.md used to record the absence of this line
# as a known limitation ("drizzle/ is not copied into the runtime image, so this
# cannot currently run as an in-cluster Job"). It is no longer optional.
#
# Copied from the BUILD stage's source tree rather than from /out: `pnpm deploy`
# prunes to what the package manifest declares, and drizzle/ is not a declared
# file, so /out/drizzle is not guaranteed to exist.
COPY --from=build /app/backend/drizzle ./drizzle

EXPOSE 3001
CMD ["node", "dist/index.js"]
